# Database — SQLite works without Docker; use PostgreSQL for production/hybrid retrieval
DATABASE_URL=sqlite+aiosqlite:///./data/nyayalens.db
DATABASE_URL_SYNC=sqlite:///./data/nyayalens.db

# PostgreSQL (requires Docker or local PostgreSQL install):
# DATABASE_URL=postgresql+asyncpg://nyayalens:nyayalens@localhost:5432/nyayalens
# DATABASE_URL_SYNC=postgresql://nyayalens:nyayalens@localhost:5432/nyayalens

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000

# LLM Provider (mock | openai | anthropic)
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Auth
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO

# File uploads
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./uploads
